# 复制到 /etc/fs-billing/monitor.env，root:root，模式 0600。
# 服务器 B 的监测脚本与 notify.sh 读取；纯 KEY=value，不含空格、引号与行内注释。
# 示例地址全部替换为实际值，真实地址与邮箱不进仓库。

# 运维邮件收件人；多个用逗号分隔（也可以填后台「告警设置」里的系统告警邮箱）。
# 这是脚本侧的收件人：Worker/数据库整体宕机时读不到后台设置，只能从本文件取。
NOTIFY_TO=ops@example.com

# check-clock.sh 的偏差阈值（秒），决定 3：警告 1、严重 5。
CLOCK_WARN_SECONDS=1
CLOCK_CRIT_SECONDS=5

# health-check.sh：同一问题多少秒内不重复发信（默认 30 分钟）。
MONITOR_DEDUPE_SECONDS=1800
# 去重状态文件目录；systemd 单元的 ReadWritePaths 要包含它。
MONITOR_STATE_DIR=/var/lib/fs-billing/monitor

# 备份清单与新鲜度（设计：超过 26 小时未更新告警）。
BACKUP_LATEST_JSON=/root/backups/LATEST.json
BACKUP_MAX_AGE_SECONDS=93600

# 磁盘、证书、journal 阈值。
DISK_WARN_PERCENT=90
TLS_CERT_FILE=/etc/ssl/fs-billing/fullchain.pem
CERT_WARN_DAYS=30
JOURNAL_WARN_BYTES=1932735283

# 健康检查地址；不写时用 app.env 里的 API_HOST/API_PORT 与 WORKER_HOST/WORKER_PORT。
# HEALTH_API_URL=http://127.0.0.1:3000/api/health
# HEALTH_WORKER_URL=http://<B_PRIVATE_IP>:3001/health
