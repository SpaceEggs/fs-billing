# 复制到服务器 A 的 /etc/fs-billing/heartbeat.env，root:root，模式 0600。
# fs-clock-heartbeat.sh 读取；纯 KEY=value，不含空格、引号与行内注释。
# 共享密钥与服务器 B 的 app.env 中 WORKER_SHARED_KEY 一致，不写进仓库。

WORKER_SHARED_KEY=replace-with-the-same-worker-shared-key
# B 的 Worker 内网或 WireGuard 地址；Worker 不监听公网，/clock 也受 IP 白名单保护。
CLOCK_WORKER_URL=http://<B_WORKER_IP>:3001/clock
