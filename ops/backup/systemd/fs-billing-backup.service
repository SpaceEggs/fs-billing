[Unit]
Description=FS-Billing 每日备份
Documentation=file:/opt/fs-billing/current/docs/ops-runbook.md
After=network-online.target postgresql.service
Wants=network-online.target
# 失败通知：ops/monitor/notify.sh 与 fs-billing-notify@.service（阶段 10 PR 4）。
OnFailure=fs-billing-notify@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/fs-billing/current/ops/backup/backup.sh --config /etc/fs-billing/backup.conf
# 备份含完整号码与客户资料：文件 600、目录 700。
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# 只有备份根目录可写；改 backup.conf 的 BACKUP_DIR 时这里要一起改。
ReadWritePaths=/root/backups
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
