# 复制到 /etc/fs-billing/app.env，root:fs-billing，模式 0640。
# API 与 Worker 共用；这里不放 owner DATABASE_URL。
# 纯 KEY=value，不要空格、引号或行内注释；systemd 与 Node 对这两种格式的解析不完全一致。
# 示例里的地址是 RFC 5737 文档地址，全部替换为实际值。

NODE_ENV=production

# 运行时角色连接；密码由 pnpm db:migrate 按 URL 设置，必须与 owner.env 中的同名键一致。
APP_DATABASE_URL=postgresql://fs_billing_app:replace-with-app-password@127.0.0.1:5432/fs_billing
AUTH_DATABASE_URL=postgresql://fs_billing_auth:replace-with-auth-password@127.0.0.1:5432/fs_billing

# 至少 32 字符；轮换会让所有会话失效。
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# 页面「邮箱设置」保存 SMTP 密码用的加密密钥：32 字节 base64，生成：
#   openssl rand -base64 32
# base64 里的 +、/、= 都是普通字符，可直接写在 KEY=value 里，不要加引号。
# 丢失后已保存的 SMTP 密码无法解密，需要到页面重填；请离线保存一份。
SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 必须是站点的 HTTPS 地址；生产环境代码会拒绝 http。
BETTER_AUTH_URL=https://203.0.113.10
# 逗号分隔的 Origin，缺省取 BETTER_AUTH_URL 的 origin；与 Web 实际访问地址一致。
BETTER_AUTH_TRUSTED_ORIGINS=https://203.0.113.10

# API 只监听回环，由 nginx 代理。
API_HOST=127.0.0.1
API_PORT=3000

# Worker 监听 B 的内网或 WireGuard 地址（只接受回环或 RFC1918 IPv4）；不能监听公网。
WORKER_HOST=10.0.0.20
WORKER_PORT=3001
# 至少 16 字符；与服务器 A 的 billing_shared_key 及 relay 配置一致。
WORKER_SHARED_KEY=replace-with-at-least-16-random-characters
# 逗号分隔，只放服务器 A 的来源地址。
WORKER_ALLOWED_IPS=10.0.0.10

# 原始 JSON 归档目录；不设置则不归档，raw_cdrs 会无限增长。
RAW_CDR_ARCHIVE_DIR=/var/lib/fs-billing/archive
# RAW_CDR_ARCHIVE_AFTER_MONTHS=6
# RAW_CDR_ARCHIVE_GRACE_DAYS=7

# 连接池与对账参数；不写则用下列默认值。
# WORKER_DB_POOL_MAX=10
# WORKER_QUEUE_POOL_MAX=2
# WORKER_DB_CONNECTION_TIMEOUT_MS=5000
# 扣费每次最多领取的任务数；取满即连续领取，空队列仍按默认 2 秒轮询。
# WORKER_CHARGE_BATCH_SIZE=10
# WORKER_RECONCILE_MIN_AGE_MINUTES=5
# WORKER_RECONCILE_ALERT_ATTEMPTS=3
# WORKER_RECONCILE_LOOKBACK_DAYS=30
# WORKER_STATEMENT_CONCURRENCY=2

# 业务参数；不写则用 packages/shared 的默认值。
# ADMIN_AMOUNT_MAX_INTEGER_DIGITS=
# ADMIN_RATE_SCHEDULE_HORIZON_MS=
# ADMIN_RATE_PREVIEW_TTL_MS=
# ADMIN_RATE_CANCEL_CLOCK_SKEW_MARGIN_SECONDS=
# ADMIN_TEMPORARY_PASSWORD_TTL_MS=

# 邮件（可选）。页面「邮箱设置」接管发信后，Worker 不再读下面这些 SMTP_* 与 MAIL_FROM；
# 它们只留给 ops/monitor/notify.sh（数据库或 Worker 宕机时仍能发信）与 mail:test 使用。
# 设了 SMTP_HOST 就必须设 MAIL_FROM；SMTP_PASS 只放本文件。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=billing@example.com
# SMTP_PASS=replace-with-smtp-authorization-code
# MAIL_FROM=billing@example.com
# SMTP_TIMEOUT_MS=15000
# MAIL_RATE_PER_MINUTE=20
# MAIL_MAX_ATTEMPTS=6
# ALERT_QUIET_MINUTES=10
# 邮件里链接的站点根地址。
# APP_PUBLIC_URL=https://203.0.113.10

# 不要在生产设置：AUTH_RATE_LIMIT_TEST_OVERRIDE_MAX、FSB_ALLOW_TEST_OVERRIDES、
# SEED_AUTH_PASSWORD、所有 PERF_*、P4_IDOR_*。
