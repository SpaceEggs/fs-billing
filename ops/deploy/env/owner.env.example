# 复制到 /etc/fs-billing/owner.env，root:root，模式 0600。
# 仅 root 与运维包装命令读取：迁移、queue:migrate、auth:bootstrap、auth:unlock、备份。
# 纯 KEY=value，不要空格、引号或行内注释。
# 示例里的地址是 RFC 5737 文档地址，全部替换为实际值。

# 标记生产环境：owner.env 未设 NODE_ENV 时，空库上误跑 db:seed 会写入演示数据。
NODE_ENV=production

# owner 角色 fs_billing；数据库迁移要求超级用户。
DATABASE_URL=postgresql://fs_billing:replace-with-owner-password@127.0.0.1:5432/fs_billing
# db:migrate 按这两个 URL 设置应用角色密码，所以必须与 app.env 中的同名键一致。
APP_DATABASE_URL=postgresql://fs_billing_app:replace-with-app-password@127.0.0.1:5432/fs_billing
AUTH_DATABASE_URL=postgresql://fs_billing_auth:replace-with-auth-password@127.0.0.1:5432/fs_billing
# auth:bootstrap 需要这两个键。
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://203.0.113.10
