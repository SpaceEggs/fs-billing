<include>
  <!-- 客户 directory/IP 路由选用 billing context；租户标签来自可信配置。 -->
  <context name="billing">
    <extension name="billing-outbound">
      <!-- 路由安全与计费长度独立；Lua 对规范化计费号码执行 15 位上限。 -->
      <condition field="destination_number" expression="^\+?[0-9]{1,17}(?![\s\S])">
        <action application="set" data="billing_authorized=false" />
        <action application="set" data="billing_dialed_number=${destination_number}" />
        <action application="lua" data="billing_authorize.lua" />
        <!-- 单独 context 重新求值授权结果，避免 XML 在 Lua 执行前就求值。 -->
        <action application="execute_extension" data="billing-bridge XML billing-authorized" />
        <action application="hangup" data="NORMAL_CLEARING" />
        <anti-action application="set" data="billing_dialed_number=${destination_number}" />
        <anti-action application="respond" data="484" />
        <anti-action application="hangup" data="INVALID_NUMBER_FORMAT" />
      </condition>
    </extension>
  </context>
  <!-- execute_extension 按 destination_number 重新寻路；此处没有外呼入口，不能递归授权。 -->
  <context name="billing-authorized">
    <extension name="billing-bridge">
      <condition field="destination_number" expression="^billing-bridge$" />
      <condition field="${billing_destination}" expression="^\+?[0-9]{1,17}(?![\s\S])">
        <anti-action application="respond" data="484" />
        <anti-action application="hangup" data="INVALID_NUMBER_FORMAT" />
      </condition>
      <condition field="${billing_authorized}" expression="^true$">
        <action application="set" data="hangup_after_bridge=true" />
        <action application="bridge" data="sofia/gateway/upstream/${billing_destination}" />
        <anti-action application="respond" data="503" />
      </condition>
    </extension>
  </context>
</include>
