# 仅用于本地开发。
POSTGRES_DB=fs_billing
POSTGRES_USER=fs_billing
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fs_billing:local-development-only@127.0.0.1:5432/fs_billing
# 应用运行时连接：非超级用户、非 BYPASSRLS；密码由 pnpm db:migrate 设置。
APP_DATABASE_URL=postgresql://fs_billing_app:local-app-only@127.0.0.1:5432/fs_billing
API_HOST=127.0.0.1
API_PORT=3000
# 仅回环或 RFC1918 内网 IPv4；禁止 0.0.0.0，默认回环。
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Worker 内网接口（阶段 3）；运行时不使用 owner 连接。
# 至少 16 字符；FreeSWITCH 与 curl 通过 X-Billing-Key 请求头发送。
WORKER_SHARED_KEY=replace-this-worker-shared-key
# 逗号分隔的实际连接来源 IP；不信任 X-Forwarded-For。
WORKER_ALLOWED_IPS=127.0.0.1

# 业务池与 pg-boss 元数据/调度池分离，连接获取超时为毫秒。
WORKER_DB_POOL_MAX=10
WORKER_QUEUE_POOL_MAX=2
WORKER_DB_CONNECTION_TIMEOUT_MS=5000
# 每分钟对账；收到或上次补投至少这么多分钟后再检查。
WORKER_RECONCILE_MIN_AGE_MINUTES=5
WORKER_RECONCILE_ALERT_ATTEMPTS=3
# 仅自动对账最近 N 天开始的通话；更早的话单需人工核对补扣。
WORKER_RECONCILE_LOOKBACK_DAYS=30
# 月账单：每天 02:00（北京时间）补建缺失月份（从租户第一个应有月份起，不设回看上限），03:00 核对；子任务并发 M。
WORKER_STATEMENT_CONCURRENCY=2
# 原始 JSON 归档（阶段 8）：每天 04:00（北京时间）把月末之后过了 AFTER_MONTHS 个月的 raw_cdrs 月分区导出到本地目录、
# 校验后分离，宽限 GRACE_DAYS 天再丢弃。目录必须是绝对路径、只有 Worker 用户可读写；归档文件是丢弃之后原文的唯一副本，
# 目录要进备份。不设置则不归档（Worker 启动时告警）。取回见 docs/phase-8-design.md「原始 JSON 归档与恢复」。
# RAW_CDR_ARCHIVE_DIR=/var/lib/fs-billing/archive
# RAW_CDR_ARCHIVE_AFTER_MONTHS=6
# RAW_CDR_ARCHIVE_GRACE_DAYS=7

# 邮件（阶段 9）：Worker 通过发件箱发送余额提醒与故障告警邮件。下面是本地 Mailpit 的值（pnpm db:up 一并启动，
# 收件箱在 http://127.0.0.1:8025）。SMTP_HOST 不设置则不发送（发件箱照常入队，Worker 启动时告警）。
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true = 隐式 TLS（465）；false = STARTTLS（587 等），只有回环地址（Mailpit）允许不加密。
SMTP_SECURE=false
MAIL_FROM=billing@example.test
# 真实服务器（如 QQ 邮箱 smtp.qq.com，465，隐式 TLS）才需要认证，两者同时设置：
#   SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=<发件邮箱账号>  SMTP_PASS=<SMTP 授权码，不是登录密码>  MAIL_FROM=<与 SMTP_USER 相同>
# 授权码只放运行环境（开发在 .env，服务器在 /etc/fs-billing.env，权限 600），不进仓库、日志和文档。
# SMTP_USER=
# SMTP_PASS=
# SMTP_TIMEOUT_MS=15000
# 每次分发（每分钟一次）最多发送的封数；单封最多尝试次数（退避 1 分、5 分、15 分、1 小时、3 小时）。
# MAIL_RATE_PER_MINUTE=20
# MAIL_MAX_ATTEMPTS=6
# 事件型告警连续这么多分钟没有新事件即恢复。
# ALERT_QUIET_MINUTES=10
# 邮件里链接的站点根地址（https://…，本机调试可用 http://127.0.0.1:5173）；不设置则邮件不含链接。
# APP_PUBLIC_URL=http://127.0.0.1:5173

# API 认证池仅能访问 auth schema；迁移入口设置角色密码。
AUTH_DATABASE_URL=postgresql://fs_billing_auth:local-auth-only@127.0.0.1:5432/fs_billing
BETTER_AUTH_SECRET=replace-this-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5173
# 仅开发 auth:seed 使用；不提供默认密码，不覆盖已有 credential。
# SEED_AUTH_PASSWORD=choose-a-development-password
