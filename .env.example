# 仅用于本地开发。
POSTGRES_DB=fs_billing
POSTGRES_USER=fs_billing
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fs_billing:local-development-only@127.0.0.1:5432/fs_billing
# 应用运行时连接：非超级用户、非 BYPASSRLS；密码由 pnpm db:migrate 设置。
APP_DATABASE_URL=postgresql://fs_billing_app:local-app-only@127.0.0.1:5432/fs_billing
API_HOST=127.0.0.1
API_PORT=3000
# 仅回环或 RFC1918 内网 IPv4；禁止 0.0.0.0，默认回环。
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Worker 内网接口（阶段 3）；运行时不使用 owner 连接。
# 至少 16 字符；FreeSWITCH 与 curl 通过 X-Billing-Key 请求头发送。
WORKER_SHARED_KEY=replace-this-worker-shared-key
# 逗号分隔的实际连接来源 IP；不信任 X-Forwarded-For。
WORKER_ALLOWED_IPS=127.0.0.1

# 业务池与 pg-boss 元数据/调度池分离，连接获取超时为毫秒。
WORKER_DB_POOL_MAX=10
WORKER_QUEUE_POOL_MAX=2
WORKER_DB_CONNECTION_TIMEOUT_MS=5000
# 每分钟对账；收到或上次补投至少这么多分钟后再检查。
WORKER_RECONCILE_MIN_AGE_MINUTES=5
WORKER_RECONCILE_ALERT_ATTEMPTS=3
# 仅自动对账最近 N 天开始的通话；更早的话单需人工核对补扣。
WORKER_RECONCILE_LOOKBACK_DAYS=30
# 月账单：每天 02:00（北京时间）补建缺失月份，03:00 核对；补缺最多回看 N 个月，子任务并发 M。
STATEMENT_BACKFILL_MONTHS=24
WORKER_STATEMENT_CONCURRENCY=2

# API 认证池仅能访问 auth schema；迁移入口设置角色密码。
AUTH_DATABASE_URL=postgresql://fs_billing_auth:local-auth-only@127.0.0.1:5432/fs_billing
BETTER_AUTH_SECRET=replace-this-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5173
# 仅开发 auth:seed 使用；不提供默认密码，不覆盖已有 credential。
# SEED_AUTH_PASSWORD=choose-a-development-password
