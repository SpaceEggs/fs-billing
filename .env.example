# 仅用于本地开发。
POSTGRES_DB=fs_billing
POSTGRES_USER=fs_billing
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fs_billing:local-development-only@127.0.0.1:5432/fs_billing
# 应用运行时连接：非超级用户、非 BYPASSRLS；密码由 pnpm db:migrate 设置。
APP_DATABASE_URL=postgresql://fs_billing_app:local-app-only@127.0.0.1:5432/fs_billing
API_HOST=127.0.0.1
API_PORT=3000
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Worker 内网接口（阶段 3）；运行时不使用 owner 连接。
WORKER_SHARED_KEY=replace-this-worker-shared-key
WORKER_ALLOWED_IPS=127.0.0.1
